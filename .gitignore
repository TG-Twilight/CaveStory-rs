.idea/
.vscode/

# Cave Story (copyrighted) data files
/data/

# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Shader binary files
*.dksh

# These are backup files generated by rustfmt
**/*.rs.bk

# cave story saves
Profile.dat*

# General
.DS_Store
.AppleDouble
.LSOverride

# Icon must end with two \r
Icon

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows thumbnail cache files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db

# Dump file
*.stackdump

# Folder config file
[Dd]esktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

*.log

3rdparty/
# Local source assets and generated investigation output
/SUCHAS/
/.cache/
/artifacts/

# Python asset tooling
__pycache__/
*.pyc

# Local maintainer handoff notes (contain device and workstation details)
/AGENTS.md
/MEMORY.md

# Public documentation is explicitly selected. Keep internal reports outside this repo.
/docs/*
!/docs/README.md
!/docs/README_zh-CN.md
!/docs/README_ja-JP.md
!/docs/CONTRIBUTING.md
!/docs/releases/
/docs/releases/*
!/docs/releases/20260922.md
**/AGENTS.md
**/MEMORY.md
/res/readme/hero-prompt.txt
/res/readme/asset-manifest.json

# Credentials and local player state
*.jks
*.keystore
.env
.env.*
settings.json
/user/
